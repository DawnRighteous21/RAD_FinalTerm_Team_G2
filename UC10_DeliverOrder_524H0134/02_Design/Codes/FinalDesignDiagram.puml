@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
title 3.4.5 Final Design Class Diagram with Navigation Arrows - UC4 (Author: 524H0134)

class ShipperDeliveryView {
    - shipperId: String
    + acceptTaskClick(shipperId: String, orderId: String): void
    + confirmPickupClick(shipperId: String, orderId: String): void
    + confirmCashCollectedClick(orderId: String, amount: Decimal): void
    + confirmDeliveryClick(shipperId: String, orderId: String): void
    + reportFailureClick(shipperId: String, orderId: String, reason: String): void
}

class DeliveryFulfilmentController {
    - orderDAO: OrderDAO
    - shipperDAO: ShipperDAO
    - hubDAO: HubDAO
    + acceptDeliveryTask(shipperId: String, orderId: String): Order
    + confirmOrderPickup(shipperId: String, orderId: String): Boolean
    + confirmCashCollected(shipperId: String, orderId: String, amount: Decimal): Decimal
    + confirmDeliverySuccess(shipperId: String, orderId: String): Order
    + reportDeliveryFailure(shipperId: String, orderId: String, reason: String): Order
}

class Order {
    - orderId: String
    - hubId: String
    - orderStatus: String
    - totalAmount: Decimal
    - paymentMethod: String
    - paymentStatus: String
    - deliveredAt: DateTime
    - failureReason: String
    + markPickedUp(shipperId: String): void
    + recordCODPayment(amount: Decimal): Boolean
    + markDelivered(): void
    + markDeliveryFailed(reason: String): void
}

class Shipper {
    - shipperId: String
    - fullName: String
    - availabilityStatus: String
    - cashOnHand: Decimal
    + assignToOrder(): void
    + addCollectedCash(amount: Decimal): Decimal
    + markAvailable(): void
}

class Hub {
    - hubId: String
    - currentActiveOrders: Integer
    + decrementActiveOrders(): Integer
}

class OrderDAO {
    + findById(orderId: String): Order
    + updateDeliveryStatus(order: Order): Boolean
}

class ShipperDAO {
    + findById(shipperId: String): Shipper
    + updateShipperStateAndCash(shipper: Shipper): Boolean
}

class HubDAO {
    + findById(hubId: String): Hub
    + updateActiveOrderCount(hubId: String, count: Integer): Boolean
}

ShipperDeliveryView "1" --> "1" DeliveryFulfilmentController : invokes >
DeliveryFulfilmentController "1" --> "1" OrderDAO : queries/updates >
DeliveryFulfilmentController "1" --> "1" ShipperDAO : queries/updates >
DeliveryFulfilmentController "1" --> "1" HubDAO : updates capacity >
DeliveryFulfilmentController ..> Order : updates status >
DeliveryFulfilmentController ..> Shipper : updates cash & state >
DeliveryFulfilmentController ..> Hub : decrements count >
Shipper "0..1" --> "0..*" Order : delivers >
@enduml
