@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
title 3.2.5 Final Design Class Diagram with Navigation Arrows - UC2 (Author: 524H0012)

class OrderCheckoutView {
    + initiateCheckoutClick(customerId: String, hubId: String, addressId: String): void
    + addItemClick(itemId: String, qty: Integer, note: String): void
    + applyVoucherClick(code: String): void
    + confirmOrderClick(paymentMethod: String, details: String): void
    + displayPriceSummary(subtotal: Decimal, fee: Decimal, discount: Decimal, total: Decimal): void
}

class PlaceOrderController {
    - currentDraftOrder: Order
    - orderDAO: OrderDAO
    - hubDAO: HubDAO
    - voucherDAO: VoucherDAO
    - paymentGateway: PaymentGatewayAdapter
    + initiateCheckout(customerId: String, hubId: String, addressId: String): Boolean
    + addItemToOrder(itemId: String, qty: Integer, note: String): Decimal
    + applyVoucher(voucherCode: String): Order
    + confirmAndPlaceOrder(paymentMethod: String, paymentDetails: String): Order
}

class Order {
    - orderId: String
    - orderDateTime: DateTime
    - orderStatus: String
    - subtotalAmount: Decimal
    - deliveryFee: Decimal
    - discountAmount: Decimal
    - totalAmount: Decimal
    - paymentMethod: String
    - paymentStatus: String
    + addOrderItem(item: MenuItem, qty: Integer, note: String): OrderItem
    + calculateDeliveryFee(distanceKm: Decimal): Decimal
    + applySingleVoucher(voucher: Voucher): Boolean
    + calculateTotalAmount(): Decimal
    + markPlaced(payStatus: String): void
}

class OrderItem {
    - orderItemId: String
    - quantity: Integer
    - unitPriceAtOrder: Decimal
    - lineTotal: Decimal
    - specialInstructions: String
    + calculateLineTotal(): Decimal
}

class Hub {
    - hubId: String
    - maxActiveOrders: Integer
    - currentActiveOrders: Integer
    + canAcceptNewOrder(): Boolean
    + incrementActiveOrders(): Integer
}

class Voucher {
    - voucherCode: String
    - discountPercentage: Decimal
    - maxDiscountAmount: Decimal
    - minOrderValue: Decimal
    + isValidForOrder(subtotal: Decimal, today: Date): Boolean
    + computeDiscount(subtotal: Decimal): Decimal
}

class OrderDAO {
    + saveOrderWithItems(order: Order): Boolean
}

class HubDAO {
    + findById(hubId: String): Hub
    + checkItemStockAtHub(hubId: String, itemId: String): HubMenuItem
    + updateActiveOrderCount(hubId: String, newCount: Integer): Boolean
}

class VoucherDAO {
    + findByCode(voucherCode: String): Voucher
}

class PaymentGatewayAdapter {
    + authorizePayment(amount: Decimal, method: String, details: String): String
}

OrderCheckoutView "1" --> "1" PlaceOrderController : invokes >
PlaceOrderController "1" --> "0..1" Order : manages >
PlaceOrderController "1" --> "1" OrderDAO : persists >
PlaceOrderController "1" --> "1" HubDAO : queries/updates >
PlaceOrderController "1" --> "1" VoucherDAO : queries >
PlaceOrderController "1" --> "1" PaymentGatewayAdapter : delegates payment >

Order "1" *--> "1..*" OrderItem : instantiates & owns >
Order "0..*" --> "0..1" Voucher : validates & applies >
PlaceOrderController ..> Hub : checks capacity >
@enduml
