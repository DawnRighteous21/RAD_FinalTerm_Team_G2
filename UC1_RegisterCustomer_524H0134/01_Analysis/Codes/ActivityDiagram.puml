@startuml
skinparam shadowing false
|Customer (Local / Tourist)|
start
:Select Register / Manage Profile;
:Choose Customer Type (Local vs Tourist);
|OFDH System|
if (Customer Type?) then (Local Customer)
  :Display Local Form (VN Phone + Name);
else (Foreign Tourist)
  :Display Tourist Form (Passport + Email + Hotel);
endif
|Customer (Local / Tourist)|
:Enter Credentials & Submit;
|OFDH System|
:Validate Uniqueness & Format;
if (Valid & Unique?) then (No)
  :Show Duplicate/Format Error;
  stop
else (Yes)
  :Create Customer Profile (State = Active);
  :Prompt for Delivery Address;
endif
|Customer (Local / Tourist)|
:Input Street/Hotel Address & District;
|OFDH System|
:Calculate Distance to Nearest Hub;
if (Within Max Delivery Distance?) then (Yes)
  :Save DeliveryAddress (State = Verified);
else (No)
  :Save DeliveryAddress with Out-of-Range Warning;
endif
:Display Profile & Address Book Confirmation;
stop
@enduml