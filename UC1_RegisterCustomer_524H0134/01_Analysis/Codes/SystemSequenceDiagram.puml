@startuml
skinparam shadowing false
autonumber
actor "Manager" as Mgr
participant ":OFDHSystem" as Sys

Mgr -> Sys : openReportingDashboard()
activate Sys
Sys --> Mgr : displayFilterOptions(reportTypes, hubList, brandList)
deactivate Sys

Mgr -> Sys : generateReport(reportType, startDate, endDate, hubIdFilter, brandIdFilter)
activate Sys
Sys --> Mgr : displayRenderedReport(reportId, totalRevenue, totalOrders, avgDeliveryTimeMins, chartData)
deactivate Sys

opt Export or Archive Report Snapshot
    Mgr -> Sys : exportOrArchiveReport(reportId, actionFormat)
    activate Sys
    Sys --> Mgr : confirmReportAction(reportId, downloadUrlOrArchiveStatus)
    deactivate Sys
end
@enduml