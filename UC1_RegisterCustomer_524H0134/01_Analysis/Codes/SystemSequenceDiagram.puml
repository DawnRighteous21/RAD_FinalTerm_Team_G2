@startuml
skinparam shadowing false
autonumber
actor "Customer\n(Local / Tourist)" as Cust
participant ":OFDHSystem" as Sys

Cust -> Sys : selectAccountType(accountType)
activate Sys
Sys --> Cust : displayRegistrationForm(requiredFields)
deactivate Sys

Cust -> Sys : submitRegistration(name, email, vnPhoneOrPassport, nationality)
activate Sys
Sys --> Cust : confirmAccountCreated(customerId, status="Active")
deactivate Sys

Cust -> Sys : addDeliveryAddress(customerId, street, district, hotelOrLandmark)
activate Sys
Sys --> Cust : confirmAddressSaved(addressId, distanceKm, isEligibleForDelivery)
deactivate Sys

opt Manage Existing Addresses (Update / Delete)
    Cust -> Sys : updateOrDeleteAddress(customerId, addressId, action, newDetails)
    activate Sys
    Sys --> Cust : displayUpdatedAddressBook(addressList)
    deactivate Sys
end
@enduml