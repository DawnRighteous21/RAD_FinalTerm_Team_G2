@startuml
skinparam shadowing false
autonumber
title 3.1.4 Detailed Sequence Diagram - UC1: Register Customer & Manage Addresses (Author: 524H0134)

actor "Customer\n(Local / Tourist)" as Cust
boundary ":RegistrationAddressView" as View
control ":CustomerRegistrationController" as Ctrl
entity ":CustomerDAO" as CDAO
entity "cust:Customer\n(Local/Tourist)" as DomCust
entity ":HubDAO" as HDAO
entity "hub:Hub" as DomHub
entity "addr:DeliveryAddress" as DomAddr
entity ":DeliveryAddressDAO" as ADAO

Cust -> View : selectAccountType(type)
activate View
View -> Ctrl : selectAccountType(type)
activate Ctrl
Ctrl --> View : requiredFieldList
deactivate Ctrl
View --> Cust : displayRegistrationForm(requiredFieldList)
deactivate View

Cust -> View : submitRegistration(type, name, email, idStr, extra)
activate View
View -> Ctrl : registerCustomer(type, name, email, idStr, extra)
activate Ctrl
Ctrl -> CDAO : existsByPhoneOrPassport(idStr)
activate CDAO
CDAO --> Ctrl : false (isUnique)
deactivate CDAO

create DomCust
Ctrl -> DomCust : <<create>>(name, email, idStr, extra)
activate DomCust
DomCust -> DomCust : validateCredentials()
DomCust -> DomCust : activateProfile()
DomCust --> Ctrl : cust (status="Active")
deactivate DomCust

Ctrl -> CDAO : insertCustomer(cust)
activate CDAO
CDAO --> Ctrl : true
deactivate CDAO
Ctrl --> View : customerId
deactivate Ctrl
View --> Cust : showConfirmation("Account Active: " + customerId)
deactivate View

Cust -> View : submitAddress(customerId, street, district, landmarkOrHotel)
activate View
View -> Ctrl : addDeliveryAddress(customerId, street, district, landmarkOrHotel)
activate Ctrl
Ctrl -> HDAO : findNearestHub(district)
activate HDAO
HDAO --> Ctrl : hub
deactivate HDAO

Ctrl -> DomHub : calculateDistanceTo(street, district)
activate DomHub
DomHub --> Ctrl : distanceKm
deactivate DomHub

create DomAddr
Ctrl -> DomAddr : <<create>>(street, district, landmarkOrHotel, distanceKm)
activate DomAddr
DomAddr -> DomAddr : verifyRange(hub.maxDeliveryDistanceKm)
DomAddr --> Ctrl : isEligible
deactivate DomAddr

Ctrl -> ADAO : insertAddress(customerId, addr)
activate ADAO
ADAO --> Ctrl : true
deactivate ADAO
Ctrl --> View : addr (addressId, distanceKm, isEligible)
deactivate Ctrl
View --> Cust : showConfirmation("Address Saved. Eligible: " + isEligible)
deactivate View

opt Update or Archive Existing Address
    Cust -> View : updateOrDeleteAddress(customerId, addressId, action, details)
    activate View
    View -> Ctrl : updateOrArchiveAddress(customerId, addressId, action, details)
    activate Ctrl
    Ctrl -> ADAO : archiveAddress(addressId)
    activate ADAO
    ADAO --> Ctrl : true
    deactivate ADAO
    Ctrl --> View : true
    deactivate Ctrl
    View --> Cust : showConfirmation("Address Book Updated")
    deactivate View
end
@enduml
