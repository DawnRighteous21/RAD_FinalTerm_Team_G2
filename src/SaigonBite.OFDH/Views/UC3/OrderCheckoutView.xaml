<UserControl x:Class="SaigonBite.OFDH.Views.UC3.OrderCheckoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <Style x:Key="PaymentOptionStyle" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextDarkBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="CardBorder"
                                Background="White"
                                BorderBrush="{StaticResource InputBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Width="14" Height="14" Margin="0,0,8,0">
                                    <Ellipse x:Name="OuterCircle" Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.5"/>
                                    <Ellipse x:Name="InnerDot" Width="8" Height="8" Fill="{StaticResource PrimaryOrangeBrush}" Visibility="Collapsed"/>
                                </Grid>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="{StaticResource LightOrangeBgBrush}"/>
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource PrimaryOrangeBrush}"/>
                                <Setter TargetName="OuterCircle" Property="Stroke" Value="{StaticResource PrimaryOrangeBrush}"/>
                                <Setter TargetName="InnerDot" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryOrangeBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CardBorder" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Setter Property="Cursor" Value="No"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource CardBgBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="10" Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="CmbCustomer" Grid.Column="0" Width="215" Height="36"
                          DisplayMemberPath="Label" VerticalContentAlignment="Center"
                          BorderBrush="{StaticResource InputBorderBrush}"
                          SelectionChanged="CmbCustomer_SelectionChanged"/>

                <ComboBox x:Name="CmbHub" Grid.Column="2" Width="225" Height="36"
                          DisplayMemberPath="DisplayLabel" VerticalContentAlignment="Center"
                          BorderBrush="{StaticResource InputBorderBrush}"
                          SelectionChanged="CmbHub_SelectionChanged"/>

                <ComboBox x:Name="CmbAddress" Grid.Column="4" Height="36"
                          DisplayMemberPath="DisplayLabel" VerticalContentAlignment="Center"
                          BorderBrush="{StaticResource InputBorderBrush}"
                          SelectionChanged="CmbAddress_SelectionChanged"/>

                <Border x:Name="HubStatusBadge" Grid.Column="6"
                        Background="{StaticResource SuccessGreenBgBrush}"
                        BorderBrush="#86EFAC" BorderThickness="1"
                        CornerRadius="6" Padding="14,0" Height="36">
                    <TextBlock x:Name="TxtHubStatusBadge"
                               Text="Quiet (2/15) • Fee: 5,000 VND"
                               FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource SuccessGreenBrush}"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="390"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource CardBgBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Available Menu Items"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource TextDarkBrush}"
                               Margin="0,0,0,10"/>

                    <Border x:Name="RedirectNoticeBanner" Grid.Row="1"
                            Background="#EFF6FF" BorderBrush="#93C5FD"
                            BorderThickness="1" CornerRadius="6"
                            Padding="12,8" Margin="0,0,0,10" Visibility="Collapsed">
                        <TextBlock x:Name="TxtRedirectNotice"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource InfoBlueBrush}"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="MenuItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="10"
                                            Padding="12" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="86"/>
                                                <ColumnDefinition Width="14"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="86" Height="86"
                                                    Background="{StaticResource LightOrangeBgBrush}"
                                                    BorderBrush="{StaticResource OrangeBorderBrush}"
                                                    BorderThickness="1" CornerRadius="8">
                                                <TextBlock Text="{Binding CategoryUpper}"
                                                           FontSize="12" FontWeight="Bold"
                                                           Foreground="{StaticResource PrimaryOrangeBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ItemName}"
                                                           FontSize="14" FontWeight="Bold"
                                                           Foreground="{StaticResource TextDarkBrush}"/>
                                                <TextBlock Text="{Binding BilingualDescription}"
                                                           FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,2,0,4"/>
                                                <TextBlock Text="{Binding PriceText}"
                                                           FontSize="13" FontWeight="Bold"
                                                           Foreground="{StaticResource PrimaryOrangeBrush}"
                                                           Margin="0,0,0,8"/>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="52"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="Qty:" FontSize="12"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               VerticalAlignment="Center" Margin="0,0,6,0"/>

                                                    <TextBox Grid.Column="1" Height="32"
                                                             Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"
                                                             HorizontalContentAlignment="Center"
                                                             VerticalContentAlignment="Center"
                                                             BorderBrush="{StaticResource InputBorderBrush}"/>

                                                    <Border Grid.Column="3" Height="32" Background="White"
                                                            BorderBrush="{StaticResource InputBorderBrush}"
                                                            BorderThickness="1" CornerRadius="4">
                                                        <Grid>
                                                            <TextBlock Text="Special instructions..."
                                                                       Foreground="#94A3B8" FontSize="11"
                                                                       Margin="8,0" VerticalAlignment="Center"
                                                                       IsHitTestVisible="False">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding NoteText}" Value="">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBox Text="{Binding NoteText, UpdateSourceTrigger=PropertyChanged}"
                                                                     Background="Transparent" BorderThickness="0"
                                                                     Padding="6,0" FontSize="12"
                                                                     VerticalContentAlignment="Center"/>
                                                        </Grid>
                                                    </Border>

                                                    <Button Grid.Column="5" Content="+ Add" Height="32" Padding="14,0"
                                                            Style="{StaticResource PrimaryButtonStyle}"
                                                            Tag="{Binding}"
                                                            Click="BtnAddMenuItem_Click"/>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Grid.Row="3" Background="{StaticResource LightOrangeBgBrush}"
                            BorderBrush="{StaticResource OrangeBorderBrush}"
                            BorderThickness="1" CornerRadius="8"
                            Padding="12,10" Margin="0,6,0,0">
                        <TextBlock Text="Smart Load-Balancing: Busy hubs (≥15 active orders) auto-redirect to nearest hub; Quiet hubs (≤3) give -10,000 VND delivery fee."
                                   FontSize="12" Foreground="#9A3412"
                                   TextAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource CardBgBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Order Cart &amp; Checkout"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource TextDarkBrush}"
                               Margin="0,0,0,10"/>

                    <DataGrid x:Name="DgCart" Grid.Row="1"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="None"
                              UseLayoutRounding="True" Background="White"
                              BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                              RowHeight="36" MinHeight="110" Margin="0,0,0,12"
                              ColumnHeaderStyle="{StaticResource ModernColumnHeaderStyle}"
                              CellStyle="{StaticResource ModernDataGridCellStyle}"
                              RowStyle="{StaticResource ModernDataGridRowStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Item" Binding="{Binding DisplayName}" Width="*"/>
                            <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="44"/>
                            <DataGridTextColumn Header="Subtotal" Binding="{Binding SubtotalText}" Width="96"/>
                            <DataGridTemplateColumn Width="34">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✕" Tag="{Binding OrderItemId}"
                                                Click="BtnRemoveCartItem_Click"
                                                Background="Transparent" Foreground="{StaticResource DangerRedBrush}"
                                                BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Height="34" Background="White"
                                    BorderBrush="{StaticResource InputBorderBrush}"
                                    BorderThickness="1" CornerRadius="6">
                                <Grid>
                                    <TextBlock x:Name="TxtVoucherPlaceholder"
                                               Text="Voucher code (e.g. VOU20)"
                                               Foreground="#94A3B8" FontSize="12"
                                               Margin="10,0" VerticalAlignment="Center"
                                               IsHitTestVisible="False"/>
                                    <TextBox x:Name="TxtVoucherCode"
                                             Background="Transparent" BorderThickness="0"
                                             Padding="8,0" FontWeight="SemiBold"
                                             VerticalContentAlignment="Center"
                                             TextChanged="TxtVoucherCode_TextChanged"/>
                                </Grid>
                            </Border>

                            <Button x:Name="BtnVoucherAction" Grid.Column="2"
                                    Content="Apply" Height="34" Padding="16,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="BtnVoucherAction_Click"/>
                        </Grid>

                        <TextBlock x:Name="TxtVoucherFeedback"
                                   FontSize="11" FontWeight="SemiBold"
                                   Margin="2,5,0,0" TextWrapping="Wrap"
                                   Visibility="Collapsed"/>
                    </StackPanel>

                    <Border Grid.Row="3" Background="{StaticResource PageBgBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Subtotal" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtSubtotal" Grid.Row="0" Grid.Column="1" Text="0 VND" FontSize="12" Foreground="{StaticResource TextDarkBrush}" HorizontalAlignment="Right" Margin="0,0,0,4"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Delivery Fee" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtDeliveryFee" Grid.Row="1" Grid.Column="1" Text="0 VND" FontSize="12" Foreground="{StaticResource TextDarkBrush}" HorizontalAlignment="Right" Margin="0,0,0,4"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Discount" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                            <TextBlock x:Name="TxtDiscount" Grid.Row="2" Grid.Column="1" Text="0 VND" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SuccessGreenBrush}" HorizontalAlignment="Right" Margin="0,0,0,6"/>

                            <Separator Grid.Row="3" Grid.ColumnSpan="2" Background="{StaticResource BorderBrush}" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Total Amount" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}"/>
                            <TextBlock x:Name="TxtTotalAmount" Grid.Row="4" Grid.Column="1" Text="0 VND" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryOrangeBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="4" Margin="0,0,0,10">
                        <TextBlock Text="Payment Method" FontSize="13" FontWeight="Bold"
                                   Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,8"/>

                        <UniformGrid Columns="2" Margin="0,0,-8,0">
                            <RadioButton x:Name="RbCod" Content="COD" GroupName="PaymentMethod"
                                         Style="{StaticResource PaymentOptionStyle}"
                                         IsChecked="True" Checked="PaymentMethod_Checked"/>
                            <RadioButton x:Name="RbMoMo" Content="MoMo" GroupName="PaymentMethod"
                                         Style="{StaticResource PaymentOptionStyle}"
                                         Checked="PaymentMethod_Checked"/>
                            <RadioButton x:Name="RbVNPay" Content="VNPay" GroupName="PaymentMethod"
                                         Style="{StaticResource PaymentOptionStyle}"
                                         Checked="PaymentMethod_Checked"/>
                            <RadioButton x:Name="RbCard" Content="Card" GroupName="PaymentMethod"
                                         Style="{StaticResource PaymentOptionStyle}"
                                         Checked="PaymentMethod_Checked"/>
                        </UniformGrid>

                        <Border Height="34" Background="#F8FAFC" BorderBrush="{StaticResource InputBorderBrush}"
                                BorderThickness="1" CornerRadius="6" Margin="0,2,0,4">
                            <Grid>
                                <TextBlock x:Name="TxtPaymentPlaceholder"
                                           Text="Not required for COD payment"
                                           Foreground="#94A3B8" FontSize="11"
                                           Margin="10,0" VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>
                                <TextBox x:Name="TxtPaymentDetails"
                                         IsEnabled="False" Background="Transparent" BorderThickness="0"
                                         Padding="8,0" FontSize="12" VerticalContentAlignment="Center"
                                         TextChanged="TxtPaymentDetails_TextChanged"/>
                            </Grid>
                        </Border>

                        <TextBlock x:Name="TxtCodNote"
                                   Text="*Note: COD disabled for Foreign Tourist"
                                   FontSize="11" FontStyle="Italic"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock x:Name="TxtCheckoutError" Grid.Row="5"
                               Foreground="{StaticResource DangerRedBrush}"
                               FontSize="11" FontWeight="SemiBold"
                               TextWrapping="Wrap" Margin="0,0,0,8"
                               Visibility="Collapsed"/>

                    <Button Grid.Row="6" Content="Confirm &amp; Place Order" Height="42"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="BtnConfirmOrder_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
