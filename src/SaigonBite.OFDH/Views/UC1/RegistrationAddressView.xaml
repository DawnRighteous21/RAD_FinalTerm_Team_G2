<!-- Author: 524H0134 (Ha Du Tuan) -->
<UserControl x:Class="SaigonBite.OFDH.Views.UC1.RegistrationAddressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             PreviewMouseDown="Root_PreviewMouseDown"
             PreviewKeyDown="Root_PreviewKeyDown">

    <UserControl.Resources>
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBgBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,14"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextDarkBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#E2E8F0"/>
                    <Setter Property="Foreground" Value="#64748B"/>
                    <Setter Property="BorderBrush" Value="#CBD5E1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InputComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="SegmentedTabButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AddressGridActionBtnStyle" TargetType="Button" BasedOn="{StaticResource GridActionButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#F1F5F9"/>
                    <Setter Property="Foreground" Value="#94A3B8"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="6*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT COLUMN: Card 1 - Customer Registration -->
        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="1. Customer Registration"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextDarkBrush}"
                           Margin="0,0,0,12"/>

                <!-- Segmented Tab Toggle -->
                <Border Grid.Row="1"
                        Background="#F1F5F9"
                        CornerRadius="8"
                        Padding="4"
                        Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="BtnTabLocal"
                                Grid.Column="0"
                                Content="Local Customer"
                                Style="{StaticResource SegmentedTabButtonStyle}"
                                Click="BtnTabLocal_Click"/>

                        <Button x:Name="BtnTabTourist"
                                Grid.Column="2"
                                Content="Foreign Tourist"
                                Style="{StaticResource SegmentedTabButtonStyle}"
                                Click="BtnTabTourist_Click"/>
                    </Grid>
                </Border>

                <!-- Form Fields -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                    <StackPanel>
                        <TextBlock Text="Full Name *" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="TxtFullName" Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,10"/>

                        <TextBlock Text="Email *" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="TxtEmail" Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,10"/>

                        <!-- Local Group -->
                        <TextBlock Text="VN Phone Number" Style="{StaticResource FieldLabelStyle}"/>
                        <Grid Margin="0,0,0,10">
                            <TextBox x:Name="TxtVnPhone" Style="{StaticResource InputTextBoxStyle}"/>
                            <TextBlock x:Name="PhVnPhone"
                                       Text="[Not Required (NULL) — COD Disabled]"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="12"
                                       FontStyle="Italic"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed"/>
                        </Grid>

                        <TextBlock Text="Preferred Local Wallet" Style="{StaticResource FieldLabelStyle}"/>
                        <Grid Margin="0,0,0,12">
                            <ComboBox x:Name="CmbWallet" Style="{StaticResource InputComboBoxStyle}" SelectedIndex="0">
                                <ComboBoxItem Content="MoMo"/>
                                <ComboBoxItem Content="VNPay"/>
                                <ComboBoxItem Content="ZaloPay"/>
                            </ComboBox>
                            <Border x:Name="OverlayWalletDisabled"
                                    Background="#E2E8F0"
                                    BorderBrush="#CBD5E1"
                                    BorderThickness="1"
                                    Visibility="Collapsed">
                                <TextBlock Text="[Not Required (NULL) — COD Disabled]"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="12"
                                           FontStyle="Italic"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"/>
                            </Border>
                        </Grid>

                        <Separator Background="{StaticResource BorderBrush}" Margin="0,2,0,12"/>

                        <!-- Tourist Group -->
                        <TextBlock Text="Passport Number" Style="{StaticResource FieldLabelStyle}"/>
                        <Grid Margin="0,0,0,10">
                            <TextBox x:Name="TxtPassport" Style="{StaticResource InputTextBoxStyle}"/>
                            <TextBlock x:Name="PhPassport"
                                       Text="[Disabled for Local Customer]"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="12"
                                       FontStyle="Italic"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"
                                       IsHitTestVisible="False"/>
                        </Grid>

                        <TextBlock Text="Nationality" Style="{StaticResource FieldLabelStyle}"/>
                        <Grid Margin="0,0,0,10">
                            <TextBox x:Name="TxtNationality" Style="{StaticResource InputTextBoxStyle}"/>
                            <TextBlock x:Name="PhNationality"
                                       Text="[Disabled for Local Customer]"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="12"
                                       FontStyle="Italic"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"
                                       IsHitTestVisible="False"/>
                        </Grid>

                        <TextBlock Text="Hotel Name" Style="{StaticResource FieldLabelStyle}"/>
                        <Grid Margin="0,0,0,10">
                            <TextBox x:Name="TxtHotelName" Style="{StaticResource InputTextBoxStyle}"/>
                            <TextBlock x:Name="PhHotelName"
                                       Text="[Disabled for Local Customer]"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="12"
                                       FontStyle="Italic"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"
                                       IsHitTestVisible="False"/>
                        </Grid>

                        <TextBlock Text="Room Number" Style="{StaticResource FieldLabelStyle}"/>
                        <Grid Margin="0,0,0,8">
                            <TextBox x:Name="TxtRoomNumber" Style="{StaticResource InputTextBoxStyle}"/>
                            <TextBlock x:Name="PhRoomNumber"
                                       Text="[Disabled for Local Customer]"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="12"
                                       FontStyle="Italic"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"
                                       IsHitTestVisible="False"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <Button Grid.Row="3"
                        x:Name="BtnRegisterAccount"
                        Content="Register Account"
                        Height="38"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0,12,0,0"
                        Click="BtnRegisterAccount_Click"/>
            </Grid>
        </Border>

        <!-- RIGHT COLUMN: Card 2 + Card 3 + Toast Bar -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Card 2: Add Delivery Address -->
            <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="2. Add Delivery Address (Max 7.0 km Radius)"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextDarkBrush}"
                               Margin="0,0,0,12"/>

                    <TextBlock Text="Active Customer" Style="{StaticResource FieldLabelStyle}"/>
                    <ComboBox x:Name="CmbActiveCustomer"
                              Style="{StaticResource InputComboBoxStyle}"
                              DisplayMemberPath="DisplayLabel"
                              Margin="0,0,0,12"
                              SelectionChanged="CmbActiveCustomer_SelectionChanged"/>

                    <!-- 2x2 Grid -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Recipient Name *" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtRecipientName" Style="{StaticResource InputTextBoxStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="District *" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="CmbDistrict"
                                      Style="{StaticResource InputComboBoxStyle}"
                                      SelectionChanged="CmbDistrict_SelectionChanged">
                                <ComboBoxItem Content="District 1"/>
                                <ComboBoxItem Content="District 3"/>
                                <ComboBoxItem Content="District 7"/>
                                <ComboBoxItem Content="Binh Thanh"/>
                                <ComboBoxItem Content="Phu Nhuan"/>
                                <ComboBoxItem Content="Tan Phu"/>
                                <ComboBoxItem Content="Thu Duc"/>
                                <ComboBoxItem Content="Nha Be"/>
                                <ComboBoxItem Content="Binh Chanh"/>
                                <ComboBoxItem Content="Cu Chi"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Text="Street Address *" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtStreetAddress" Style="{StaticResource InputTextBoxStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Text="Hotel / Landmark" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TxtLandmark" Style="{StaticResource InputTextBoxStyle}"/>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <CheckBox x:Name="ChkIsDefault"
                                      Content="Set as Default"
                                      FontSize="12.5"
                                      Foreground="{StaticResource TextDarkBrush}"
                                      IsChecked="True"
                                      Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtHubDistanceHint"
                                       Text="Nearest Hub &amp; Distance Check: &lt;= 7.0 km"
                                       FontSize="11.5"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                x:Name="BtnSaveAddress"
                                Content="Verify Distance &amp; Save"
                                Height="36"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="BtnSaveAddress_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Card 3: Saved Delivery Addresses (UC14 Modern DataGrid Style) -->
            <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="3. Saved Delivery Addresses"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextDarkBrush}"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                                   Text="Note: Archiving executes soft-delete (status = 'Archived') to preserve order history"
                                   FontSize="11"
                                   FontStyle="Italic"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"/>
                    </Grid>

                    <DataGrid x:Name="DgAddresses"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              UseLayoutRounding="True"
                              Background="White"
                              BorderThickness="0"
                              RowHeight="42"
                              SelectionMode="Single"
                              ColumnHeaderStyle="{StaticResource ModernColumnHeaderStyle}"
                              CellStyle="{StaticResource ModernDataGridCellStyle}"
                              RowStyle="{StaticResource ModernDataGridRowStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding AddressId}" Width="84"/>
                            <DataGridTextColumn Header="Street &amp; District" Binding="{Binding StreetAndDistrict}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Landmark / Hotel" Binding="{Binding LandmarkDisplay}" Width="135">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Distance" Binding="{Binding DistanceKmFromHub, StringFormat={}{0:0.0} km}" Width="82">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="Status" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#E2E8F0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Verified">
                                                            <Setter Property="Background" Value="#DCFCE7"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="OutOfRange">
                                                            <Setter Property="Background" Value="#FEE2E2"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Archived">
                                                            <Setter Property="Background" Value="#E2E8F0"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#475569"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Verified">
                                                                <Setter Property="Foreground" Value="#16A34A"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="OutOfRange">
                                                                <Setter Property="Foreground" Value="#DC2626"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Archived">
                                                                <Setter Property="Foreground" Value="#475569"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Actions" Width="136">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Edit"
                                                    Tag="{Binding}"
                                                    IsEnabled="{Binding CanModify}"
                                                    Style="{StaticResource AddressGridActionBtnStyle}"
                                                    Background="#EFF6FF"
                                                    Foreground="#2563EB"
                                                    Margin="0,0,6,0"
                                                    Click="BtnEditAddress_Click"/>
                                            <Button Content="Archive"
                                                    Tag="{Binding}"
                                                    IsEnabled="{Binding CanModify}"
                                                    Style="{StaticResource AddressGridActionBtnStyle}"
                                                    Background="#FEE2E2"
                                                    Foreground="#DC2626"
                                                    Click="BtnArchiveAddress_Click"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Feedback Toast Bar -->
            <Border x:Name="ToastBorder"
                    Grid.Row="4"
                    Background="#EFF6FF"
                    BorderBrush="#BFDBFE"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,10">
                <TextBlock x:Name="TxtToastMessage"
                           Text="Ready — Register a new Local Customer / Foreign Tourist or manage saved delivery addresses."
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#2563EB"
                           TextWrapping="Wrap"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>