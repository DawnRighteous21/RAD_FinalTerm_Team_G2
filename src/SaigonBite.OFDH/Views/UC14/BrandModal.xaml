<Window x:Class="SaigonBite.OFDH.Views.UC14.BrandModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Virtual Brand"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White"
        FontFamily="Segoe UI">

    <StackPanel Margin="24">
        <TextBlock x:Name="TxtModalTitle"
                   Text="Create New Virtual Brand"
                   FontSize="18" FontWeight="Bold"
                   Foreground="{StaticResource TextDarkBrush}"
                   Margin="0,0,0,16"/>

        <TextBlock Text="Brand Name *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,4"/>
        <TextBox x:Name="TxtBrandName" Height="34" Padding="8,6" BorderBrush="{StaticResource InputBorderBrush}" Margin="0,0,0,12"/>

        <TextBlock Text="Cuisine Type *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,4"/>
        <TextBox x:Name="TxtCuisineType" Height="34" Padding="8,6" BorderBrush="{StaticResource InputBorderBrush}" Margin="0,0,0,12"/>

        <TextBlock Text="Description" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,4"/>
        <TextBox x:Name="TxtDescription" Height="64" Padding="8,6" TextWrapping="Wrap" AcceptsReturn="True" BorderBrush="{StaticResource InputBorderBrush}" Margin="0,0,0,12"/>

        <TextBlock x:Name="TxtError"
                   Foreground="{StaticResource DangerRedBrush}"
                   FontSize="12" TextWrapping="Wrap"
                   Visibility="Collapsed" Margin="0,0,0,12"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Cancel" Width="90" Height="36" Margin="0,0,10,0"
                    Style="{StaticResource CancelButtonStyle}"
                    Click="BtnCancel_Click"/>
            <Button Content="Save Brand" Height="36" Style="{StaticResource PrimaryButtonStyle}"
                    Click="BtnSave_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
