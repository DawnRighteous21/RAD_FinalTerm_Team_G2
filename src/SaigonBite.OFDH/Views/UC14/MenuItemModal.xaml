<Window x:Class="SaigonBite.OFDH.Views.UC14.MenuItemModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bilingual Menu Item"
        Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White"
        FontFamily="Segoe UI">

    <StackPanel Margin="24">
        <TextBlock x:Name="TxtModalTitle"
                   Text="Create New Bilingual Menu Item"
                   FontSize="18" FontWeight="Bold"
                   Foreground="{StaticResource TextDarkBrush}"
                   Margin="0,0,0,16"/>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Virtual Brand *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,4"/>
                <ComboBox x:Name="CmbBrand" Height="34" DisplayMemberPath="DisplayLabel" BorderBrush="{StaticResource InputBorderBrush}"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Category *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,4"/>
                <ComboBox x:Name="CmbCategory" Height="34" BorderBrush="{StaticResource InputBorderBrush}">
                    <ComboBoxItem Content="Main" IsSelected="True"/>
                    <ComboBoxItem Content="Drink"/>
                    <ComboBoxItem Content="Side"/>
                    <ComboBoxItem Content="Dessert"/>
                    <ComboBoxItem Content="Combo"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Item Name *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtItemName" Height="34" Padding="8,6" BorderBrush="{StaticResource InputBorderBrush}"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Unit Price (VND) *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtUnitPrice" Height="34" Padding="8,6" BorderBrush="{StaticResource InputBorderBrush}"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="Description (EN)*" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,4"/>
        <TextBox x:Name="TxtDescEn" Height="34" Padding="8,6" BorderBrush="{StaticResource InputBorderBrush}" Margin="0,0,0,12"/>

        <TextBlock Text="Description (VI)*" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,4"/>
        <TextBox x:Name="TxtDescVi" Height="34" Padding="8,6" BorderBrush="{StaticResource InputBorderBrush}" Margin="0,0,0,12"/>

        <TextBlock Text="Assign to Cloud Hubs (HubMenuItems) *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,6"/>
        <Border Background="{StaticResource PageBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
            <WrapPanel x:Name="HubCheckBoxPanel"/>
        </Border>

        <TextBlock x:Name="TxtError"
                   Foreground="{StaticResource DangerRedBrush}"
                   FontSize="12" TextWrapping="Wrap"
                   Visibility="Collapsed" Margin="0,0,0,12"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Cancel" Width="90" Height="36" Margin="0,0,10,0"
                    Style="{StaticResource CancelButtonStyle}"
                    Click="BtnCancel_Click"/>
            <Button Content="Save Menu Item" Height="36" Style="{StaticResource PrimaryButtonStyle}"
                    Click="BtnSave_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
