<UserControl x:Class="SaigonBite.OFDH.Views.UC8.KitchenDisplayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             PreviewMouseDown="Root_PreviewMouseDown"
             PreviewKeyDown="Root_PreviewKeyDown">

    <UserControl.Resources>
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBgBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,14"/>
        </Style>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#F1F5F9"/>
                    <Setter Property="Foreground" Value="#94A3B8"/>
                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StockToggleBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="132"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#FFF1F2"/>
            <Setter Property="BorderBrush" Value="#FECDD3"/>
            <Setter Property="Foreground" Value="#BE123C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAvailableInStock}" Value="False">
                    <Setter Property="Background" Value="#ECFDF5"/>
                    <Setter Property="BorderBrush" Value="#A7F3D0"/>
                    <Setter Property="Foreground" Value="#047857"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="16,11">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <ComboBox x:Name="CmbHub"
                              Width="250"
                              Height="34"
                              DisplayMemberPath="DisplayLabel"
                              VerticalContentAlignment="Center"
                              BorderBrush="{StaticResource InputBorderBrush}"
                              Background="#F8FAFC"
                              SelectionChanged="CmbHub_SelectionChanged"/>

                    <Border x:Name="BadgeHubCapacity"
                            Background="#DCFCE7"
                            CornerRadius="14"
                            Padding="14,6"
                            Margin="14,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="TxtHubCapacity"
                                   Text="Active: 2 / 15 | Quiet"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#15803D"/>
                    </Border>

                    <TextBlock x:Name="TxtQueueCounts"
                               Text="Incoming: 0 | Confirmed: 0 | Preparing: 0 | Ready: 0"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextDarkBrush}"
                               VerticalAlignment="Center"
                               Margin="18,0,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtStaffId"
                               Text="Staff: STF-K01"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,14,0"/>

                    <Button x:Name="BtnRefreshQueue"
                            Content="Refresh Queue"
                            Height="34"
                            Background="#1E293B"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="BtnRefreshQueue_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="65*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="35*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="52*"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="48*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Live Kitchen Order Queue (FIFO)"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextDarkBrush}"
                                   Margin="0,0,0,10"/>

                        <DataGrid x:Name="DgKitchenQueue"
                                  Grid.Row="1"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="None"
                                  UseLayoutRounding="True"
                                  Background="White"
                                  BorderThickness="0"
                                  RowHeight="48"
                                  SelectionMode="Single"
                                  ColumnHeaderStyle="{StaticResource ModernColumnHeaderStyle}"
                                  CellStyle="{StaticResource ModernDataGridCellStyle}"
                                  RowStyle="{StaticResource ModernDataGridRowStyle}"
                                  SelectionChanged="DgKitchenQueue_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Order ID" Binding="{Binding OrderId}" Width="84">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Time / Timer" Binding="{Binding KitchenTimeSummary}" Width="112">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="11.5"/>
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Items &amp; Notes" Binding="{Binding ItemsSummary}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="12"/>
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn Header="Status" Width="154">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="8" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#E2E8F0"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding OrderStatus}" Value="Placed">
                                                                <Setter Property="Background" Value="#DBEAFE"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding OrderStatus}" Value="ConfirmedByKitchen">
                                                                <Setter Property="Background" Value="#E0E7FF"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding OrderStatus}" Value="InPreparation">
                                                                <Setter Property="Background" Value="#FEF3C7"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding OrderStatus}" Value="ReadyForPickup">
                                                                <Setter Property="Background" Value="#DCFCE7"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding OrderStatus}" FontSize="11" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#334155"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding OrderStatus}" Value="Placed">
                                                                    <Setter Property="Foreground" Value="#1D4ED8"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding OrderStatus}" Value="ConfirmedByKitchen">
                                                                    <Setter Property="Foreground" Value="#4338CA"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding OrderStatus}" Value="InPreparation">
                                                                    <Setter Property="Foreground" Value="#B45309"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding OrderStatus}" Value="ReadyForPickup">
                                                                    <Setter Property="Foreground" Value="#15803D"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Action" Binding="{Binding KitchenActionHint}" Width="112">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="11.5"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="TxtActiveOrderHeader"
                                       Text="Active Order Control — Select an Order"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextDarkBrush}"
                                       Margin="0,0,0,2"/>

                            <TextBlock x:Name="TxtActiveOrderMeta"
                                       Text="Select an order from the FIFO queue above to confirm, start preparation, mark ready, or reject."
                                       FontSize="11.5"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,0,0,10"/>

                            <Border Background="#F8FAFC"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12,10"
                                    Margin="0,0,0,10">
                                <DockPanel>
                                    <Border DockPanel.Dock="Left"
                                            Width="24" Height="24"
                                            CornerRadius="12"
                                            Background="White"
                                            BorderBrush="{StaticResource InputBorderBrush}"
                                            BorderThickness="1"
                                            Margin="0,0,10,0">
                                        <TextBlock Text="✓"
                                                   FontWeight="Bold"
                                                   FontSize="12"
                                                   Foreground="#059669"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock x:Name="TxtActiveOrderChecklist"
                                               Text="No order selected"
                                               FontSize="12.5"
                                               Foreground="{StaticResource TextDarkBrush}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>

                            <WrapPanel Margin="0,0,0,10" VerticalAlignment="Center">
                                <Button x:Name="BtnConfirmOrder"
                                        Content="Confirm Order"
                                        Background="#2563EB"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Margin="0,0,8,4"
                                        Click="BtnConfirmOrder_Click"/>

                                <Button x:Name="BtnStartPrep"
                                        Content="Start Preparation"
                                        Background="{StaticResource PrimaryOrangeBrush}"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Margin="0,0,8,4"
                                        Click="BtnStartPrep_Click"/>

                                <Button x:Name="BtnMarkReady"
                                        Content="Mark Order Ready"
                                        Background="#059669"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Margin="0,0,10,4"
                                        Click="BtnMarkReady_Click"/>

                                <Border x:Name="BadgeCancelLock"
                                        Background="#FFF1F2"
                                        CornerRadius="14"
                                        Padding="12,6"
                                        VerticalAlignment="Center"
                                        Margin="0,0,0,4">
                                    <TextBlock x:Name="TxtCancelLock"
                                               Text="Customer Cancel: OPEN"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               Foreground="#BE123C"/>
                                </Border>
                            </WrapPanel>

                            <Separator Background="{StaticResource BorderBrush}" Margin="0,2,0,10"/>

                            <TextBlock x:Name="TxtRejectHeading"
                                       Text="Reject Unconfirmed Order (Placed orders only)"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextDarkBrush}"
                                       Margin="0,0,0,8"/>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="175"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="125"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox x:Name="CmbRejectReason"
                                          Grid.Column="0"
                                          Height="34"
                                          VerticalContentAlignment="Center"
                                          BorderBrush="{StaticResource InputBorderBrush}"
                                          SelectedIndex="0">
                                    <ComboBoxItem Content="IngredientOutOfStock"/>
                                    <ComboBoxItem Content="KitchenOverloaded"/>
                                    <ComboBoxItem Content="Other"/>
                                </ComboBox>

                                <Grid Grid.Column="2">
                                    <TextBox x:Name="TxtRejectDetails"
                                             Style="{StaticResource InputTextBoxStyle}"
                                             TextChanged="TxtRejectDetails_TextChanged"/>
                                    <TextBlock x:Name="PhRejectDetails"
                                               Text="Required if &quot;Other&quot;: enter explanation..."
                                               FontSize="12"
                                               Foreground="#94A3B8"
                                               VerticalAlignment="Center"
                                               Margin="10,0,0,0"
                                               IsHitTestVisible="False"/>
                                </Grid>

                                <Button x:Name="BtnRejectOrder"
                                        Grid.Column="4"
                                        Content="Reject Order"
                                        Height="34"
                                        Background="{StaticResource DangerRedBrush}"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Click="BtnRejectOrder_Click"/>
                            </Grid>

                            <TextBlock Text="Guard Rules: Reject requires a reason (mandatory explanation when &quot;Other&quot; is selected — T-10). Unconfirmed orders auto-cancel at 05:00 (A-08)."
                                       FontSize="11"
                                       FontStyle="Italic"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="62*"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="38*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="TxtStockHeader"
                                   Grid.Row="0"
                                   Text="HUB-D1 Live Menu Stock (US-11)"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextDarkBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"/>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="IcHubStock">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="12,9"
                                                Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayTitle}"
                                                           FontSize="12.5"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource TextDarkBrush}"
                                                           HorizontalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,0,0,6"/>

                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,0,8">
                                                    <TextBlock Text="{Binding DailyLimitText}"
                                                               FontSize="11.5"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,12,0"/>

                                                    <Border CornerRadius="10"
                                                            Padding="10,3"
                                                            VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#DCFCE7"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAvailableInStock}" Value="False">
                                                                        <Setter Property="Background" Value="#FEE2E2"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding StockStatusText}" FontSize="11" FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#15803D"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsAvailableInStock}" Value="False">
                                                                            <Setter Property="Foreground" Value="#B91C1C"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </StackPanel>

                                                <Button Content="{Binding ToggleActionText}"
                                                        Tag="{Binding}"
                                                        HorizontalAlignment="Center"
                                                        Style="{StaticResource StockToggleBtnStyle}"
                                                        Click="BtnToggleStock_Click"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Shipper Dispatch &amp; System Alerts"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextDarkBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"/>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="IcAlerts">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F8FAFC"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="4"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0"
                                                        Background="{Binding AccentBrush}"
                                                        CornerRadius="8,0,0,8"/>

                                                <StackPanel Grid.Column="1" Margin="10,8">
                                                    <TextBlock Text="{Binding HeaderText}"
                                                               FontSize="11.5"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource TextDarkBrush}"/>
                                                    <TextBlock Text="{Binding Detail}"
                                                               FontSize="11.5"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border x:Name="ToastBorder"
                Grid.Row="4"
                Background="#EFF6FF"
                BorderBrush="#BFDBFE"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="✕"
                        Width="24" Height="24"
                        FontSize="11"
                        FontWeight="Bold"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{StaticResource TextMutedBrush}"
                        Cursor="Hand"
                        Click="BtnDismissToast_Click"/>
                <TextBlock x:Name="TxtToastMessage"
                           Text="Ready — Select an order from the FIFO queue to confirm, start preparation, mark ready, or toggle hub menu stock."
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#2563EB"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
