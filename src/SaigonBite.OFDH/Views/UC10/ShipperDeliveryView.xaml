<!-- Author: 524H0134 (Ha Du Tuan) -->
<UserControl x:Class="SaigonBite.OFDH.Views.UC10.ShipperDeliveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             PreviewMouseDown="Root_PreviewMouseDown"
             PreviewKeyDown="Root_PreviewKeyDown">

    <UserControl.Resources>
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBgBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,14"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextDarkBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#E2E8F0"/>
                    <Setter Property="Foreground" Value="#64748B"/>
                    <Setter Property="BorderBrush" Value="#CBD5E1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP STRIP: Shipper KPI Strip -->
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="16,12">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="Active Shipper:"
                               VerticalAlignment="Center"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,0,8,0"/>

                    <ComboBox x:Name="CmbShipper"
                              Width="270"
                              Height="36"
                              DisplayMemberPath="DisplayLabel"
                              VerticalContentAlignment="Center"
                              BorderBrush="{StaticResource InputBorderBrush}"
                              SelectionChanged="CmbShipper_SelectionChanged"/>

                    <!-- Status Badge -->
                    <Border x:Name="BadgeShipperStatus"
                            Background="{StaticResource SuccessGreenBgBrush}"
                            CornerRadius="12"
                            Padding="12,5"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="TxtShipperStatus"
                                   Text="Available"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource SuccessGreenBrush}"/>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Border Background="#F8FAFC"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,6"
                            Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Cash on Hand (VND): "
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtCashOnHand"
                                       Text="0"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryOrangeBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Button x:Name="BtnRefreshQueue"
                            Content="Refresh Queue"
                            Height="36"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="BtnRefreshQueue_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- MIDDLE CONTENT: 2 Columns (~46% Left, ~54% Right) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="46*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="54*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: Card 1 - Assigned & Ready-for-Pickup Orders -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="1. Assigned &amp; Ready-for-Pickup Orders"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextDarkBrush}"
                               Margin="0,0,0,10"/>

                    <DataGrid x:Name="DgOrders"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              UseLayoutRounding="True"
                              Background="White"
                              BorderThickness="0"
                              RowHeight="42"
                              SelectionMode="Single"
                              ColumnHeaderStyle="{StaticResource ModernColumnHeaderStyle}"
                              CellStyle="{StaticResource ModernDataGridCellStyle}"
                              RowStyle="{StaticResource ModernDataGridRowStyle}"
                              SelectionChanged="DgOrders_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Order ID" Binding="{Binding OrderId}" Width="88">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Hub" Binding="{Binding HubId}" Width="74"/>
                            <DataGridTextColumn Header="Payment" Binding="{Binding PaymentMethod}" Width="74"/>
                            <DataGridTextColumn Header="Total (VND)" Binding="{Binding TotalAmount, StringFormat={}{0:N0}}" Width="92">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Status" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#FFF7ED"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding OrderStatus}" Value="PickedUp">
                                                            <Setter Property="Background" Value="#DBEAFE"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding OrderStatus}" Value="Delivered">
                                                            <Setter Property="Background" Value="#DCFCE7"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding OrderStatus}" Value="DeliveryFailed">
                                                            <Setter Property="Background" Value="#FEE2E2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding OrderStatus}" FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#E65100"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding OrderStatus}" Value="PickedUp">
                                                                <Setter Property="Foreground" Value="#2563EB"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding OrderStatus}" Value="Delivered">
                                                                <Setter Property="Foreground" Value="#16A34A"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding OrderStatus}" Value="DeliveryFailed">
                                                                <Setter Property="Foreground" Value="#DC2626"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Selected Order Details Box -->
                    <Border Grid.Row="2"
                            Background="{StaticResource PageBgBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10"
                            Margin="0,12,0,12">
                        <StackPanel>
                            <TextBlock Text="Selected Order Route &amp; Details"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextDarkBrush}"
                                       Margin="0,0,0,6"/>
                            <TextBlock x:Name="TxtDetailPickupHub"
                                       Text="Pickup Hub: —"
                                       FontSize="12"
                                       Foreground="{StaticResource TextDarkBrush}"
                                       Margin="0,0,0,3"/>
                            <TextBlock x:Name="TxtDetailDeliverTo"
                                       Text="Deliver to: Select an order from the queue above."
                                       FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,3"/>
                            <TextBlock x:Name="TxtDetailPayment"
                                       Text="Payment &amp; Total: —"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryOrangeBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Accept & Pickup Buttons -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="BtnAcceptTask"
                                Grid.Column="0"
                                Content="Accept Delivery Task"
                                Style="{StaticResource ActionButtonStyle}"
                                Background="#2563EB"
                                Click="BtnAcceptTask_Click"/>

                        <Button x:Name="BtnConfirmPickup"
                                Grid.Column="2"
                                Content="Confirm Pickup"
                                Style="{StaticResource ActionButtonStyle}"
                                Background="{StaticResource PrimaryOrangeBrush}"
                                Click="BtnConfirmPickup_Click"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- RIGHT COLUMN: Card 2 (Handover & COD) + Card 3 (Failure Guard Rules) -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Card 2: Active Delivery Handover & COD Settlement -->
                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="2. Active Delivery Handover &amp; COD Settlement"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextDarkBrush}"
                                   Margin="0,0,0,12"/>

                        <!-- Active Order Summary Box -->
                        <Border Grid.Row="1"
                                Background="{StaticResource PageBgBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,12"
                                Margin="0,0,0,14">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock x:Name="TxtActiveOrderId"
                                               DockPanel.Dock="Left"
                                               Text="Order: None selected"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextDarkBrush}"/>
                                    <TextBlock x:Name="TxtActiveOrderStatus"
                                               DockPanel.Dock="Right"
                                               Text="—"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center"/>
                                </DockPanel>

                                <TextBlock x:Name="TxtActiveDestination"
                                           Text="Destination: —"
                                           FontSize="12.5"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8"/>

                                <Border x:Name="PaymentRuleBanner"
                                        Background="#FFF7ED"
                                        BorderBrush="#FDBA74"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10,7">
                                    <TextBlock x:Name="TxtPaymentRule"
                                               Text="Select a picked-up order to view payment settlement instructions."
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryOrangeBrush}"
                                               TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- COD Input + Button -->
                        <StackPanel Grid.Row="2" Margin="0,0,0,14">
                            <TextBlock Text="Cash Collected (VND)" Style="{StaticResource FieldLabelStyle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="TxtCashCollected"
                                         Grid.Column="0"
                                         Style="{StaticResource InputTextBoxStyle}"/>

                                <Button x:Name="BtnConfirmCash"
                                        Grid.Column="2"
                                        Content="Confirm Cash Collected"
                                        Height="36"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Background="{StaticResource PrimaryOrangeBrush}"
                                        Click="BtnConfirmCash_Click"/>
                            </Grid>
                        </StackPanel>

                        <!-- Large Green Delivery Success Button -->
                        <Button x:Name="BtnConfirmDelivery"
                                Grid.Row="4"
                                Content="Confirm Delivery Success"
                                Height="44"
                                FontSize="14"
                                Style="{StaticResource ActionButtonStyle}"
                                Background="{StaticResource SuccessGreenBrush}"
                                Click="BtnConfirmDelivery_Click"/>
                    </Grid>
                </Border>

                <!-- Card 3: Report Delivery Failure (Guard Rules) -->
                <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="3. Report Delivery Failure (Guard Rules)"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextDarkBrush}"
                                   Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Contact Attempts (min 3)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TxtContactAttempts"
                                         Text="0"
                                         Style="{StaticResource InputTextBoxStyle}"
                                         TextChanged="GuardInput_TextChanged"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Wait Time mins (min 10)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TxtWaitMinutes"
                                         Text="0"
                                         Style="{StaticResource InputTextBoxStyle}"
                                         TextChanged="GuardInput_TextChanged"/>
                            </StackPanel>
                        </Grid>

                        <Border x:Name="GuardStatusBorder"
                                Background="#FEE2E2"
                                BorderBrush="#FECACA"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,7"
                                Margin="0,0,0,12">
                            <TextBlock x:Name="TxtGuardStatus"
                                       Text="Locked: Requires >= 3 contact attempts AND >= 10 mins wait"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource DangerRedBrush}"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <TextBlock Text="Failure Reason" Style="{StaticResource FieldLabelStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox x:Name="CmbFailureReason"
                                      Grid.Column="0"
                                      Height="38"
                                      VerticalContentAlignment="Center"
                                      BorderBrush="{StaticResource InputBorderBrush}"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="CustomerNoAnswer"/>
                                <ComboBoxItem Content="WrongAddress"/>
                                <ComboBoxItem Content="SevereWeather"/>
                                <ComboBoxItem Content="CustomerRefused"/>
                            </ComboBox>

                            <Button x:Name="BtnReportFailure"
                                    Grid.Column="2"
                                    Content="Report Delivery Failure"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Background="{StaticResource DangerRedBrush}"
                                    Click="BtnReportFailure_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- BOTTOM FEEDBACK TOAST BAR -->
        <Border x:Name="ToastBorder"
                Grid.Row="4"
                Background="#EFF6FF"
                BorderBrush="#BFDBFE"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10">
            <TextBlock x:Name="TxtToastMessage"
                       Text="Ready — Select a ready order to accept, confirm pickup, collect exact COD cash, or complete delivery."
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#2563EB"
                       TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>